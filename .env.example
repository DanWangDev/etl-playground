# ETL Playground Configuration
# Copy this file to .env and adjust values

# ── Java (required for PySpark) ──
# Set this to your JDK 11-21 installation
JAVA_HOME=C:/Program Files/Java/jdk-21.0.11
# Scale: number of viewing events to generate
#   500000 = fast local iteration / CI
#   5000000 = benchmark scale (exposes partition/shuffle behavior)
#   20000000 = full scale (requires ~30 min, 8+ GB RAM)
DATA_SCALE=500000
RANDOM_SEED=42

# ── Content Dimensions ──
NUM_CONTENT_ITEMS=1000
NUM_REGIONS=4
REGIONS=UK,US,DE,JP

# ── Date Range ──
# Event window: generate events from START_DATE to today
START_DATE=2026-07-14

# ── Data Quality Injection ──
# Fraction of records with intentional quality issues (0.0-1.0)
DUPLICATE_RATE=0.0025
MALFORMED_RATE=0.0007
LATE_EVENT_RATE=0.0042

# ── Spark Configuration ──
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=200

# ── Paths ──
DATA_RAW_DIR=data/raw
DATA_CURATED_DIR=data/curated
DATA_REJECTED_DIR=data/rejected
RUNS_DIR=runs
SCHEMA_DIR=schema
WAREHOUSE_PATH=data/warehouse.duckdb

# ── Logging ──
LOG_LEVEL=INFO
LOG_JSON=true
